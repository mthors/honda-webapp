# ==============================================================================
# Honda Mega Persada Mandiri — Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit real credentials or .env.local to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client Configuration (Public anonymous access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Dealership Official Contact Configuration
# Used for wa.me prefilled handoff (international format without leading + or 0)
NEXT_PUBLIC_DEALER_WHATSAPP=6281234567890

# Dealership Notification Inbox (Server-side only)
# Used for optional internal notifications on new lead submissions
NOTIFICATION_EMAIL_TO=sales@megapersada.co.id

